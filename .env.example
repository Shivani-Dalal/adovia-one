# Supabase project — Settings → API in the dashboard.
# Both values are safe in the browser: the publishable key is public by design and
# RLS is what actually protects the data. The service-role key must NEVER appear
# here or anywhere else in this project — it lives only in the Edge Function's
# environment.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY
